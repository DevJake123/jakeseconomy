{
	"schemaVersion": 1,
	"id": "jakeseconomy",
	"version": "${version}",
	"name": "Jake's Economy",
	"description": "A dynamic player-driven economy mod with a live market, coin currency, real-time price trends, and achievement-locked items.",
	"authors": [
		"devjake123"
	],
	"contact": {
		"homepage": "https://github.com/devjake123/jakeseconomy",
		"sources":  "https://github.com/devjake123/jakeseconomy",
		"issues":   "https://github.com/devjake123/jakeseconomy/issues"
	},
	"license": "LGPL-2.1",
	"icon": "assets/jakeseconomy/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.github.devjake123.testmod.JakesEconomy"
		],
		"client": [
			"com.github.devjake123.testmod.client.JakesEconomyClient"
		],
		"fabric-datagen": [
			"com.github.devjake123.testmod.client.JakesEconomyDataGenerator"
		]
	},
	"mixins": [
		"jakeseconomy.mixins.json",
		{
			"config": "jakeseconomy.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.2",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	}
}